# 小程序生产构建 API 基地址（云函数模式下实际请求走 VITE_CLOUD_BASE，此处为回落值）
# 已废弃原假域名（公网不存在）；统一使用云 API 网关域名，微信小程序要求 HTTPS
VITE_API_BASE=https://cloud1-d4gyvmo1d9a1e148a.service.tcloudbase.com

# ============ 云开发（CloudBase）配置 ============
# 启用云函数模式（微信云），请求按路由分发到各云函数
VITE_USE_CLOUD=1
VITE_CLOUD_ENV_ID=cloud1-d4gyvmo1d9a1e148a
# 控制台访问服务中显示的默认域名（避免自动拼接域名与控制台不一致）
VITE_CLOUD_BASE=https://cloud1-d4gyvmo1d9a1e148a.ap-guangzhou.app.tcloudbase.com

# ============ 微信小程序运行时环境 API ============
# develop 模式下（用 build 产物在开发者工具中调试）下连本地后端
VITE_WECHAT_DEV_API=http://127.0.0.1:3001
# trial（体验版）和 release（正式版）默认使用 VITE_API_BASE（云函数模式走 VITE_CLOUD_BASE）
# 如需体验版使用独立测试环境，取消注释并填入真实 HTTPS 地址：
# VITE_WECHAT_TRIAL_API=https://your-trial-api.example.com
# 如需正式版使用独立地址，取消注释并填入真实 HTTPS 地址：
# VITE_WECHAT_RELEASE_API=https://your-release-api.example.com
