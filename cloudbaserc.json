{
  "envId": "cloud1-d4gyvmo1d9a1e148a",
  "region": "ap-guangzhou",
  "framework": {
    "plugins": {
      "server": {
        "use": "@cloudbase/framework-plugin-run",
        "inputs": {
          "name": "server",
          "entry": "./server",
          "path": "/",
          "port": 3001,
          "dockerfilePath": "./Dockerfile"
        }
      },
      "admin": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "name": "admin",
          "entry": "./admin/dist"
        }
      }
    }
  }
}
