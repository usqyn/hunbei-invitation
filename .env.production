# 生产环境 API 地址
# 部署时必须替换为实际 HTTPS 域名，微信小程序要求 HTTPS
VITE_API_BASE=https://api.TOYtamaxia.com

# ============ 云开发（CloudBase）配置 ============
# 启用云函数模式后，请求按 path 前缀分发到 8 个云函数 HTTP 触发器
# H5 dev 环境不开启（走 vite proxy → 旧 Express 服务）
VITE_USE_CLOUD=1
VITE_CLOUD_ENV_ID=cloud1-d1g9id3fjffcefe0d
# CLOUD_BASE 默认为 https://{ENV_ID}.service.tcloudbase.com，如需自定义可取消注释
# VITE_CLOUD_BASE=https://cloud1-d1g9id3fjffcefe0d.service.tcloudbase.com
